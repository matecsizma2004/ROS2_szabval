<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ragasztas</name>
  <version>0.1.0</version>
  <description>Ragasztás szimuláció KUKA KR 6 R900-2 robottal: mock képszenzor + MoveIt Cartesian pályák.</description>
  <maintainer email="mate.csizmadia@ewiser.hu">matecsizma2004</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>kuka_agilus_support</exec_depend>
  <exec_depend>kuka_kr_moveit_config</exec_depend>
  <exec_depend>moveit</exec_depend>
  <exec_depend>ros2_controllers</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
